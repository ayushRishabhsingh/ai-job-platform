# Copy this file to .env and edit. Never commit the real .env.

# ---------------- App ----------------
APP_NAME="AI Job Recommendation & Resume Analyzer API"
DEBUG=true

# ---------------- Database ----------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./jobs.db
# PostgreSQL (local):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jobsdb
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/jobsdb
# AWS RDS:
# DATABASE_URL=postgresql+psycopg2://admin:PASSWORD@your-db.abc123.ap-south-1.rds.amazonaws.com:5432/jobsdb

# ---------------- Security ----------------
# Generate a real one with:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- Uploads ----------------
MAX_UPLOAD_MB=5

# ---------------- Matching ----------------
# overlap | tfidf | embedding
DEFAULT_MATCH_STRATEGY=overlap
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------- Pagination ----------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
